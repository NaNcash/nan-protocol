# Import a dedicated test wallet: cast wallet import sepolia-deployer --interactive
SEPOLIA_ACCOUNT=sepolia-deployer
# Local path only; never put a password or private key in this file.
# SEPOLIA_PASSWORD_FILE=/tmp/sepolia-keystore-password
# Optional public address: permits a dry run without unlocking the keystore.
# SEPOLIA_DEPLOYER=0x...
# Server-side RPC: may contain provider credentials; never copied to the UI manifest.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: defaults to the deployer; controls reserve governance and price scenarios.
# SEPOLIA_AUTHORIZER=0x...
# Optional: verify during broadcast when configured.
# ETHERSCAN_API_KEY=
